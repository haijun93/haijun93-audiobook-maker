# Required only for Gemini API TTS.
GEMINI_API_KEY=
# GOOGLE_API_KEY=

# Optional. Chrome is discovered automatically on macOS, Windows, and Linux.
# AUDIOBOOK_CHROME_PATH=/path/to/chrome

# Local web interface settings.
AUDIOBOOK_WEB_HOST=127.0.0.1
AUDIOBOOK_WEB_PORT=7860
AUDIOBOOK_WEB_DATA_DIR=.webui
AUDIOBOOK_MAX_UPLOAD_MB=100
